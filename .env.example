# ── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/camdrive

# ── Google Drive (OAuth2) ──────────────────────────────────────────────────
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtain via: cd server && node scripts/getRefreshToken.js
GOOGLE_REFRESH_TOKEN=
# The Google Drive folder ID where all inspection folders are created
DRIVE_ROOT_FOLDER_ID=

# ── Auth ───────────────────────────────────────────────────────────────────
# Manager login password
ADMIN_PASSWORD=
# Random secret for signing JWT tokens — use a long random string
JWT_SECRET=
# Team access code — required to submit/view inspections as a field team member
TEAM_PASSWORD=

# ── Cloudflare R2 (pending photo storage) ─────────────────────────────────
# Create a bucket at dash.cloudflare.com → R2, then generate an API token with
# Object Read & Write permissions scoped to that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=camdrive-pending

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
# Railway sets PORT automatically — do not set this manually on Railway
PORT=3001
# CORS allowed origin — set to your Railway domain (or custom domain if configured)
ALLOWED_ORIGIN=https://camdrive-production.up.railway.app
